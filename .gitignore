REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_SUPPORT_EMAIL=webasolution@gmail.com
REACT_APP_SALES_EMAIL=webasolution@gmail.com
REACT_APP_INFO_EMAIL=info@webasolutions.net
REACT_APP_SUPPORT_PHONE=0712200198
REACT_APP_EMERGENCY_PHONE=0712200198
REACT_APP_COMPANY_NAME=Weba Solutions
REACT_APP_MAINTENANCE_MODE=false
NODE_ENV=development

