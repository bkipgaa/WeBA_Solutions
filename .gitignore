STRIPE_SECRET_KEY=*
STRIPE_PUBLIC_KEY=*
S3_ACCESS_KEY=*
S3_SECRET_KEY=*

# Add to .gitignore
# ============================================
# LOCAL EXPRESS SERVER FILES (DO NOT PUSH)
# ============================================

