# ================================
# ROOT .gitignore - Enhanced for Payment Backend
# ================================

# ========== NODE MODULES ==========
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ========== ENVIRONMENT VARIABLES ==========
# NEVER commit .env files with real credentials!
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# ========== PAYMENT BACKEND (Vercel Serverless) ==========
# Vercel
.vercel
.vercel_cache
.vercel/output
.vercel/project.json

# Build outputs
dist/
build/
.next/
out/

# Logs
logs/
*.log
*.pid
*.seed
*.pid.lock

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# ========== DATABASE ==========
# MongoDB local data
/data/
/dump/
*.dump
*.bson
*.json.gz

# SQLite (if you ever use)
*.db
*.sqlite
*.sqlite3

# ========== EMAIL & TEMPLATES ==========
# Email attachments
email-attachments/
email-templates/cache/

# ========== TEMPORARY FILES ==========
temp/
tmp/
uploads/
*.tmp
*.temp
.cache
.parcel-cache
.eslintcache
.stylelintcache

# ========== IDE & EDITOR ==========
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.sublime-*
.project
.classpath
.settings/

# ========== SECURITY & SECRETS ==========
# NEVER commit these
secrets/
*.pem
*.key
*.crt
*.p12
*.pfx
*.cer
*.p8
*.private
*.secret
credentials.json
service-account.json

# ========== PAYMENT GATEWAY TEST FILES ==========
paypal-sandbox/
paystack-test/
test-payments/
mock-responses/

# ========== API DOCUMENTATION ==========
# Auto-generated API docs
apidocs/
swagger-ui/
redoc-static.html

# ========== TESTING ==========
coverage/
.nyc_output/
*.test.js
*.spec.js
__tests__/
__mocks__/
jest.config.js
test-results/

# ========== DEBUGGING ==========
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
debug.log

# ========== DEPENDENCY FOLDERS ==========
node_modules/
jspm_packages/
bower_components/

# ========== PACKAGE MANAGER FILES ==========
# NPM
.npm
.npmrc

# Yarn
.yarn/
.yarn-integrity
.yarnclean
.pnp.*
.yarnrc.yml
.yarnrc

# ========== BUILD TOOLS ==========
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.fusebox/
.parcel-cache/

# ========== SERVERLESS ==========
.serverless/
.serverless_plugins/

# ========== DOCKER ==========
docker-compose.override.yml
.dockerignore
*.dockerfile
docker-data/

# ========== NGINX / PROXY ==========
nginx.conf
.htaccess
.htpasswd

# ========== SSL CERTIFICATES (DEVELOPMENT) ==========
# Only ignore dev certs, not production
*.dev.crt
*.dev.key
localhost.crt
localhost.key

# ========== APPLICATION-SPECIFIC ==========
# WeBA Infinity Solutions specific
subscription-exports/
reports/
invoice-templates/cache/
customer-uploads/

# ========== BACKUP FILES ==========
*.bak
*.backup
*.old
*.orig

# ========== OS SPECIFIC ==========
# macOS
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.directory-lock
.fuse_hidden*

# ========== ENVIRONMENT EXAMPLE FILES ==========
# Keep the example file
!.env.example
!.env.sample
!.env.template

# ========== CONFIGURATION FILES WITH SECRETS ==========
config/production.json
config/development.json
config/staging.json
config/local.json
config/secrets.json

# ========== DEVELOPMENT ONLY ==========
