PAYSTACK_PUBLIC_KEY=*
PAYSTACK_LIVE_SECRET_KEY=*
PAYSTACK_LIVE_PUBLIC_KEY=*

# PayPal
PAYPAL_CLIENT_ID=*
PAYPAL_CLIENT_SECRET=*
PAYPAL_MERCHANT_EMAIL=*
PAYPAL_MERCHANT_ID=*
PAYPAL_WEBHOOK_ID=*
PAYPAL_LIVE_CLIENT_ID=*
PAYPAL_LIVE_CLIENT_SECRET=*

# ========== EMAIL CREDENTIALS ==========
EMAIL_USER=*
EMAIL_PASS=*
EMAIL_HOST=*
EMAIL_PORT=*
ADMIN_EMAIL=*
SMTP_PASSWORD=*
SMTP_USERNAME=*

# ========== DATABASE CREDENTIALS ==========
MONGODB_URI=*
MONGODB_USER=*
MONGODB_PASSWORD=*
DATABASE_URL=*
DB_PASSWORD=*

# ========== API KEYS ==========
API_KEY=*
API_SECRET=*
SECRET_KEY=*
JWT_SECRET=*
JWT_REFRESH_SECRET=*
ENCRYPTION_KEY=*

# ========== THIRD-PARTY SERVICES ==========
