{
  "name": "webasolutions-server",
  "version": "1.0.0",
  "description": "Full Stack WeBA Solutions App - Payment Gateway Integration",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "dev": "concurrently \"npm run server\" \"cd ../client && npm start\"",
    "build": "cd ../client && npm install && npm run build",
    "install-all": "npm install && cd ../client && npm install",
    "heroku-postbuild": "npm run build",
    
    "vercel-build": "echo 'Building for Vercel...'",
    "vercel-dev": "vercel dev",
    "vercel-deploy": "vercel deploy --prod",
    
    "deploy": "npm run build && npm start"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^6.11.2",
    "express-validator": "^6.15.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.8.0",
    "nodemailer": "^8.0.3"
  },
  "devDependencies": {
    "concurrently": "^7.6.0",
    "nodemon": "^3.1.14",
    "@vercel/node": "^3.0.28"
  }
}